# Copy to .env only on the offline host. Never commit the populated file.
POSTGRES_DSN=postgres://igame:replace-me@postgres.internal:5432/igame?sslmode=require
BOOTSTRAP_ADMIN=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
# Exactly 32 random bytes. Example: printf 'base64:%s' "$(openssl rand -base64 32 | tr -d '\n')"
ENCRYPTION_KEY=base64:replace-with-a-base64-encoded-32-byte-key
